FROM python:3.12-slim

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src/ ./src/
RUN pip install --no-cache-dir ".[web]" && useradd --create-home alice
USER alice
ENV ALICE_DEMO=1
EXPOSE 8080
# Dashboard only. No broker credentials or mounted home directories.
# ALICE_DEMO blocks this dashboard's live-order route, not every CLI command.
ENTRYPOINT ["python", "-m", "open_alice", "dashboard"]
CMD ["--host", "0.0.0.0", "--port", "8080"]
